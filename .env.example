# ── Centauri Aegis Environment Configuration ───────────────────────────────

# ── Authentication ─────────────────────────────────────────────────────────
# Set both to enable console password protection. Omit to run in single-user mode.
# AEGIS_USERNAME=admin
# AEGIS_PASSWORD=changeme

# Optional: HMAC signing secret for session tokens (defaults to SHA-256 of AEGIS_PASSWORD)
# AEGIS_SESSION_SECRET=your-random-32-byte-hex-string-here

# Explicitly bypass authentication even if credentials are present
# AEGIS_AUTH_DISABLED=true

# ── Security & Network Hardening ───────────────────────────────────────────
# Allow targeting localhost / RFC 1918 private subnets in production mode.
# By default, private subnets are permitted in development, but restricted in production.
# AEGIS_ALLOW_PRIVATE_TARGETS=false

# Trust X-Forwarded-For headers from upstream reverse proxy for rate-limiting
# AEGIS_TRUSTED_PROXY=false

# ── Cryptographic Key Vault ────────────────────────────────────────────────
# Secret for server-side in-memory AES-256-GCM target API key encryption.
# If omitted, Centauri Aegis generates a secure ephemeral 256-bit key per process.
# AEGIS_KEY_SECRET=your-vault-encryption-secret-here
